global:
  scrape_schedule: "0 * * * *"
  schedule_timezone: UTC
  locations: [europe-west1]
  temporal:
    address: temporal:7233
    namespace: default
    task_queue: gcp-metrics-exporter
storage:
  elasticsearch:
    addresses: [http://elasticsearch:9200]
    index_prefix: gcp-inventory

resources:
  - billing
  - cloud_run_service
  - cloud_run_revision
  - cloud_run_worker_pool

projects:
  - name: production
    id: target-project-id
    billing:
      query_project: billing-project
      location: EU
      table: billing-project.billing_dataset.gcp_billing_export_v1_ABCDEF_123456
      group_by_service: false
      group_by_cost_type: false
    access:
      # Leave credentials unset to use Application Default Credentials. To use
      # a separate identity, uncomment the exact environment reference below;
      # the environment value must be credential JSON, not a filename.
      # credentials: "${GCME_PRODUCTION_CREDENTIALS}"
      # impersonation:
      #   target_service_account: exporter-reader@target-project-id.iam.gserviceaccount.com
      #   delegates: []
      #   lifetime: 1h
