{
  "index_patterns": ["gcp-inventory-*"],
  "priority": 100,
  "template": {
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": { "type": "date" },
        "resource": {
          "properties": {
            "type": { "type": "keyword" },
            "id": { "type": "keyword" },
            "name": { "type": "keyword" }
          }
        },
        "cloud": {
          "properties": {
            "provider": { "type": "keyword" },
            "project": { "type": "keyword" },
            "location": { "type": "keyword" }
          }
        },
        "gcp": {
          "properties": {
            "billing_month": { "type": "keyword" },
            "service": { "type": "keyword" },
            "cost": { "type": "double" },
            "currency": { "type": "keyword" }
          }
        }
      }
    }
  }
}
